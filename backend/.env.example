# Пример настроек. Скопируйте в .env и заполните своими значениями.
# Файл .env в git не попадает (он в .gitignore) — храните секреты только в нём.

# --- Подтверждение почты по коду (Brevo) ---
# Если эти переменные не заданы, код подтверждения печатается в консоль бэкенда
# (режим разработки). Чтобы письма реально уходили на почту — заполните оба поля.

# API-ключ из Brevo: https://app.brevo.com → SMTP & API → API Keys → Create a new key
BREVO_API_KEY=

# Адрес-отправитель. В Brevo его нужно подтвердить:
# Senders, Domains & Dedicated IPs → Senders → Add a sender (придёт письмо для подтверждения).
EMAIL_FROM=your-verified-sender@example.com

# Имя отправителя (как увидит пользователь)
EMAIL_FROM_NAME=FastAPI Shop

# Сколько минут действует код подтверждения
VERIFICATION_CODE_TTL_MINUTES=15

# --- Подтверждение через Telegram (опционально) ---
# Общий секрет между backend и telegram-bot (любая длинная случайная строка).
# Должен совпадать с INTERNAL_SECRET в telegram-bot/.env
TELEGRAM_INTERNAL_SECRET=
# Username бота без @ (для ссылки t.me/<username>?start=...)
TELEGRAM_BOT_USERNAME=
