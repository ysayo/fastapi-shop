# Пример настроек Telegram-бота. Скопируйте в .env и заполните.
# (.env в git не попадает.)

# Токен бота от @BotFather (создайте бота: /newbot)
BOT_TOKEN=

# Адрес backend. Локально: http://localhost:8000
# В docker-compose: http://backend:8000
BACKEND_URL=http://localhost:8000

# Общий секрет — ДОЛЖЕН совпадать с TELEGRAM_INTERNAL_SECRET в backend/.env
INTERNAL_SECRET=
